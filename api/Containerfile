# rockem API: the inference node's scheduler, FastAPI under uvicorn. Built by infra.lead
# (tcdent's request, 2026-10-23); runs as the Nomad job in api.nomad.hcl, at https://rockem.a10k.co.
#   podman build --network host -t registry.a10k.co/rockem/api:<git sha> -f Containerfile . && podman push …
# --network host: under rootless podman (pasta) the build shares elsenor's address, so pypi.a10k.co
# (Caddy on .2) is the build container itself and refuses the connection.
# The bundle is not in the image: the job mounts it read-only, so the API's manifest is always the
# node's.
FROM registry.a10k.co/library/python:3.13-slim
COPY --from=ghcr.io/astral-sh/uv:0.10.12 /uv /usr/local/bin/uv
WORKDIR /app
ENV UV_PROJECT_ENVIRONMENT=/app/.venv UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
COPY pyproject.toml uv.lock ./
# dependencies only: the package itself runs from /app/rockem
RUN uv sync --frozen --no-dev --no-install-project --no-cache
COPY rockem ./rockem
USER 1000:1000
ENTRYPOINT ["/app/.venv/bin/uvicorn", "rockem.app:app"]
