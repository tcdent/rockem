#!/bin/sh
# rockem /init — mount what the node binary needs, bring up the LAN, mount the weights, then become the node.
#   rockem.net=dhcp          DHCP on every ethernet link (busybox udhcpc, /etc/udhcpc.sh), clock from the lease's NTP servers
#   rockem.nfs=<ip>:/<path>  the weights share, read-only at /bundle; rockem.bundle=/bundle/<name> picks one
#   rockem.telnet=1          dev: a root shell on the LAN, port 23
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mount -t proc     proc     /proc
mount -t sysfs    sysfs    /sys
mkdir -p /dev/hugepages /dev/shm /dev/pts /tmp /bundle
mount -t devpts devpts /dev/pts
mount -t hugetlbfs -o pagesize=2M hugetlbfs /dev/hugepages 2>/dev/null || mount -t hugetlbfs hugetlbfs /dev/hugepages 2>/dev/null
mount -t tmpfs tmpfs /tmp
# the firmware knobs stage (knobs.efi, chained by iPXE ahead of the kernel) leaves its report in a UEFI
# variable the OS can read; into the kernel log, so the netconsole carries it
mount -t efivarfs efivarfs /sys/firmware/efi/efivars 2>/dev/null
k=/sys/firmware/efi/efivars/RockemKnobs-5d2a6b7e-8f30-4c1b-9a6e-0c6f1e2d3b4a
[ -r "$k" ] && tail -c +5 "$k" | tr -d '\000' | sed 's/^/knobs    : /' > /dev/kmsg
ip link set lo up
# the last occurrence wins, as for the kernel's own parameters (the netboot line may repeat ours)
arg() { v=; for t in $(cat /proc/cmdline); do case $t in "$1"=*) v=${t#"$1"=};; esac; done; echo "$v"; }

if [ "$(arg rockem.net)" = dhcp ]; then
  for d in /sys/class/net/*; do
    n=${d##*/}; [ "$n" = lo ] && continue; [ -e "$d/device" ] || continue
    ip link set "$n" up
    udhcpc -i "$n" -s /etc/udhcpc.sh -O ntpsrv -n -q -t 10 -T 2 >/dev/null 2>&1 &
  done
  wait
  ip -4 -o addr show scope global | sed 's/^/net      : /'
  # the clock: set once from the lease's NTP servers before the node starts, then held by ntpd
  if [ -s /etc/ntp-servers ]; then
    P=$(sort -u /etc/ntp-servers | sed 's/^/-p /' | tr '\n' ' ')
    timeout 15 ntpd -n -q $P >/dev/null 2>&1 && echo "clock    : $(date -u '+%Y-%m-%d %H:%M:%S') UTC" || echo "clock    : NTP failed; clock unset"
    ntpd $P
  fi
fi
# dev rung: a bundle shared in by QEMU over virtio-9p (see os/qemu.sh)
p=$(arg rockem.bundle9p); [ -n "$p" ] && mount -t 9p -o trans=virtio,version=9p2000.L,msize=1048576 "$p" /bundle
p=$(arg rockem.nfs);      [ -n "$p" ] && { mount -t nfs4 -o ro,nolock "$p" /bundle && echo "nfs      : $p at /bundle" || echo "nfs      : mount of $p failed"; }
[ "$(arg rockem.telnet)" = 1 ] && telnetd -l /bin/sh && echo "telnet   : root shell on port 23"
# host and GPU metrics to voria (INFRA-52); it waits for a real host name and a set clock on its own.
# Started here, from a running init: as an rdinit= wrapper ahead of init it stalled metatron's boot.
setsid /usr/bin/voria-agent </dev/null >/dev/null 2>&1 &
# the node's output goes through the kernel log: on the console as before, in `dmesg` over telnet,
# and over netconsole to the log host when the command line names one (printk.devkmsg=on lifts the
# rate limit on these writes). Backtraces on a panic, with line numbers (the node keeps line tables).
export RUST_BACKTRACE=1
exec /node >/dev/kmsg 2>&1
