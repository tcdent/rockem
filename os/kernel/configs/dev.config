# dev profile: node plus the tools to look at it.
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_KPROBES=y
CONFIG_PERF_EVENTS=y
CONFIG_DEBUG_FS=y
CONFIG_NETCONSOLE=y
# CONFIG_BLK_DEV_NVME is not set
# CONFIG_SATA_AHCI is not set
# CONFIG_R8169 is not set
# CONFIG_EXT4_FS is not set
# dev rung only: the bundle is shared into the QEMU guest over virtio-9p (os/qemu.sh), and its LAN is virtio-net
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_NETWORK_FILESYSTEMS=y
CONFIG_9P_FS=y
