# lasenora profile: the dev GPU box. Keeps its disk, its 2.5GbE and USB so it still boots
# Debian from the same firmware; adds netconsole and the EFI framebuffer because it has no
# BMC and amdgpu is built without a display engine.
CONFIG_FTRACE=y
CONFIG_KPROBES=y
CONFIG_BLK_DEV_NVME=y
CONFIG_SATA_AHCI=y
CONFIG_ATA=y
CONFIG_R8169=y
CONFIG_EXT4_FS=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_HID=y
CONFIG_NETCONSOLE=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
