# rockem base fragment — applied after olddefconfig + localyesconfig on the lasenora baseline.
# Every line here is a decision recorded in localai/software/os-release.md.

# --- structure: one static object, no loader, firmware embedded ---
# vcn_4_0_0 (video codec) is unused but required: without it amdgpu fails the whole card at
# early_init (first boot on the 7R13 box, 2026-10-14). TOC and *_kicker files never load here:
# TOC is for RLC-backdoor loading, kicker is for 744B/7551 parts; ours are 744C rev CC.
# CONFIG_MODULES is not set
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_ZSTD=y
CONFIG_INITRAMFS_COMPRESSION_ZSTD=y
CONFIG_EXTRA_FIRMWARE="amdgpu/gc_11_0_0_imu.bin amdgpu/gc_11_0_0_me.bin amdgpu/gc_11_0_0_mec.bin amdgpu/gc_11_0_0_mes.bin amdgpu/gc_11_0_0_mes1.bin amdgpu/gc_11_0_0_mes_2.bin amdgpu/gc_11_0_0_pfp.bin amdgpu/gc_11_0_0_rlc.bin amdgpu/gc_11_0_0_rlc_1.bin amdgpu/psp_13_0_0_sos.bin amdgpu/psp_13_0_0_ta.bin amdgpu/sdma_6_0_0.bin amdgpu/smu_13_0_0.bin amdgpu/vcn_4_0_0.bin"
CONFIG_EXTRA_FIRMWARE_DIR="/work/os/firmware"

# --- GPU: amdgpu headless, KFD, P2P framework on ---
CONFIG_DRM=y
CONFIG_DRM_AMDGPU=y
# CONFIG_DRM_AMD_DC is not set
# CONFIG_DRM_AMDGPU_SI is not set
# CONFIG_DRM_AMDGPU_CIK is not set
CONFIG_HSA_AMD=y
CONFIG_HSA_AMD_P2P=y
# CONFIG_HSA_AMD_SVM is not set
CONFIG_PCI_P2PDMA=y
CONFIG_ZONE_DEVICE=y

# --- IOMMU translated, VFIO on iommufd (the 6.19+ dma-buf path) ---
CONFIG_IOMMU_SUPPORT=y
CONFIG_AMD_IOMMU=y
CONFIG_IOMMU_DEFAULT_DMA_LAZY=y
# CONFIG_IOMMU_DEFAULT_PASSTHROUGH is not set
CONFIG_IOMMUFD=y
CONFIG_VFIO=y
CONFIG_VFIO_PCI=y
CONFIG_VFIO_PCI_CORE=y
CONFIG_VFIO_DEVICE_CDEV=y
# CONFIG_VFIO_NOIOMMU is not set

# --- isolation and placement ---
CONFIG_NO_HZ_FULL=y
CONFIG_RCU_NOCB_CPU=y
CONFIG_CPU_ISOLATION=y
CONFIG_NUMA=y
# CONFIG_NUMA_BALANCING is not set
CONFIG_HUGETLBFS=y
CONFIG_HUGETLB_PAGE=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
# CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS is not set
# CONFIG_KSM is not set
CONFIG_PREEMPT_VOLUNTARY=y
CONFIG_HZ_250=y
CONFIG_HWMON=y
CONFIG_SENSORS_K10TEMP=y
CONFIG_PERF_EVENTS=y
# the box's own telemetry (2026-10-16, the socket-asymmetry work): the HSMP mailbox (per-socket
# fabric/memory clocks, DDR bandwidth, DIMM thermals, DF P-state at runtime), DIMM temperature
# sensors over the SMBus, the memory controllers' EDAC view, MSRs from user space
CONFIG_AMD_HSMP_PLAT=y
CONFIG_SENSORS_JC42=y
# the IT8613E Super I/O: the BIOS-driven fan headers (tachometers, PWM, SmartGuardian curves),
# the board thermistors, the rails. The driver is os/kernel/patches/hwmon/it87.c (2026-10-31).
CONFIG_SENSORS_IT87=y
CONFIG_EDAC_AMD64=y
CONFIG_X86_MSR=y

# --- network: the LAN only; the fabric NIC belongs to VFIO ---
CONFIG_NET=y
CONFIG_INET=y
# CONFIG_IPV6 is not set
CONFIG_IXGBE=y
# CONFIG_MLX5_CORE is not set
# CONFIG_INFINIBAND is not set
# CONFIG_WIRELESS is not set
# CONFIG_CFG80211 is not set

# --- filesystems: what an initramfs needs ---
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEBUG_FS=y

# --- console ---
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_NETCONSOLE=y

# --- off ---
# CONFIG_SOUND is not set
# CONFIG_AUDIT is not set
# CONFIG_SECURITY_SELINUX is not set
# CONFIG_SECURITY_APPARMOR is not set
# CONFIG_SUSPEND is not set
# CONFIG_HIBERNATION is not set
# CONFIG_DRM_I915 is not set
# CONFIG_DRM_NOUVEAU is not set
# CONFIG_DRM_RADEON is not set

# --- the node hosts no VMs ---
# CONFIG_VIRTUALIZATION is not set
# CONFIG_KVM is not set
